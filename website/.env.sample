# Variables de entorno del frontend (Next.js). Copiá este archivo a `.env`:
#
#   cp .env.sample .env
#
# Si en cambio corrés todo con Docker (`docker/desarrollo-local/`), no hace falta escribir
# nada: las variables ya están en `docker/desarrollo-local/.env.docker`, y le ganan a este
# archivo dentro del contenedor (ver el README en la raíz).

# URL de la API de Django. El navegador nunca la llama directamente: los Route Handlers de
# Next hacen la llamada del lado del servidor, así que puede apuntar a un host interno
# (docker) o externo (producción) sin exponer nada distinto al cliente.
API_URL=http://localhost:8000

# Clave para firmar la sesión de NextAuth. Cualquier string sirve en local; para generar
# una nueva: `openssl rand -base64 32`. La de acá es la misma que usa
# `docker/desarrollo-local/.env.docker`, sin ningún valor real.
AUTH_SECRET=45c6a74be5ca74bf57ca764e5a64b5a7e4a5f7e4ba57c4567a4b57a45e67a4ce

# Intervalo (en segundos) con el que el cliente revisa la sesión y dispara el refresh
# proactivo del access token. Es independiente de la duración real de los tokens de
# Django (esa la devuelve la propia API en cada login/refresh, no hace falta duplicarla acá).
NEXT_PUBLIC_AUTH_REFRESH_INTERVAL=60
