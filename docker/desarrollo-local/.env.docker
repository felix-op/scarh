# Variables del entorno de desarrollo local. Sirven para el backend y para el frontend.
#
# Este archivo **se versiona a propósito**: no hay ninguna credencial real acá. Todo lo
# que contiene apunta a los contenedores de este mismo compose, y las claves son de
# descarte.
#
# Se llama `.env.docker` y no `.env.local` porque el `.gitignore` de la raíz ignora
# `.env.local`, así que ese nombre no se podría subir al repositorio.
#
# Las variables llegan al contenedor por `env_file`, es decir como variables de entorno
# reales. Eso importa para el frontend: Next carga sus archivos `.env` con `@next/env`,
# que **no sobrescribe** una variable que ya exista en el entorno. Por eso lo que se
# define acá le gana a `website/.env`, y el entorno del contenedor queda predecible sin
# tener que borrar ni renombrar nada en el host.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# `DB_HOST` es el nombre del servicio en el compose, no `localhost`: los contenedores se
# resuelven entre sí por DNS interno.
DB_HOST=db
DB_PORT=5432
DB_NAME=labsoft
DB_USER=labsoft
DB_PASSWORD=labsoft

# Las mismas credenciales con los nombres que espera la imagen de Postgres. Tienen que
# coincidir con las DB_* de arriba: son la misma base vista desde los dos lados.
POSTGRES_DB=labsoft
POSTGRES_USER=labsoft
POSTGRES_PASSWORD=labsoft

# Los puertos publicados en el host (5433, 8000 y 3000) están en el compose con valores
# por defecto. Docker Compose no puede leerlos desde este archivo.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=desarrollo-local-clave-de-descarte-no-usar-en-produccion
# `api` y `web` son los nombres de servicio: hacen falta para las llamadas entre
# contenedores, además de los hosts del navegador.
ALLOWED_HOSTS=localhost,127.0.0.1,api,web,labsoft_api
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=True

# Carga las fixtures de roles, limnígrafos y ubicaciones en el primer arranque.
CARGAR_FIXTURES=true

# ---------------------------------------------------------------------------
# Usuarios que se crean solos en el primer arranque
# ---------------------------------------------------------------------------
# Las contraseñas tienen que pasar las reglas de validación del formulario del frontend,
# así que no pueden ser cortas ni iguales al nombre de usuario.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=super-secure-password
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Local
ADMIN_IS_STAFF=True

# Usuario sin permisos de administración, para probar los roles de sólo lectura.
USER_USERNAME=operador
USER_PASSWORD=super-secure-password
USER_EMAIL=operador@example.com
USER_FIRST_NAME=Operador
USER_LAST_NAME=Local
USER_IS_STAFF=True

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# En local el correo se imprime en la consola del contenedor `labsoft_api` en lugar de
# salir por SMTP. Los códigos de recuperación de contraseña se leen ahí, así que no hay
# ninguna credencial de correo que configurar.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=desarrollo@example.com
EMAIL_HOST_PASSWORD=sin-clave-en-local

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=120
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# El navegador nunca llama a Django directamente: `RequestClient` pega a `/api/` y los
# Route Handlers de Next hacen la llamada real con `RequestSSR`. Por eso `API_URL` puede
# ser el hostname interno del contenedor.
API_URL=http://api:8000
AUTH_SECRET=45c6a74be5ca74bf57ca764e5a64b5a7e4a5f7e4ba57c4567a4b57a45e67a4ce
# Cada cuántos segundos el cliente revisa la sesión y dispara el refresh del token.
NEXT_PUBLIC_AUTH_REFRESH_INTERVAL=60
