# Imagen del frontend Next.js para desarrollo local.
#
# A diferencia de `Dockerfile.web.production`, acá **no** se hace `pnpm build`: el
# contenedor corre `pnpm dev`, con el código montado desde el host para que el
# hot-reload funcione.
#
# El contexto de build es la raíz del repositorio, no esta carpeta.

FROM node:22-alpine

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.17.0 --activate

WORKDIR /app

# Las dependencias se instalan en una capa aparte para que no se reinstalen con cada
# cambio de código. `node_modules` queda dentro de la imagen: el compose lo protege del
# bind mount con un volumen anónimo, así el `node_modules` del host (que puede tener
# binarios compilados para otra plataforma) no lo pisa.
COPY website/package.json website/pnpm-lock.yaml website/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY website .

# Los bind mounts no propagan eventos inotify en todas las plataformas (Windows y
# macOS entre ellas), así que el watcher de Next pasa a polling.
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 3000

CMD ["pnpm", "dev", "--hostname", "0.0.0.0"]
