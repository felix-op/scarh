# Variables de entorno para correr el backend (y el simulador) sin Docker.
#
# `backend/core/settings.py` las carga con `load_dotenv` desde la raíz del repositorio,
# así que este archivo tiene que llamarse `.env` y vivir acá, no en `backend/`.
#
#   cp .env.sample .env
#
# Si en cambio usás Docker (`docker/desarrollo-local/`), no hace falta escribir nada de
# esto: las variables ya están en `docker/desarrollo-local/.env.docker`, versionado con
# valores de descarte.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=desarrollo-local-clave-de-descarte-no-usar-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=True

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Un PostgreSQL corriendo en el host, con esta base, usuario y schema ya creados:
#
#   CREATE DATABASE scarh;
#   CREATE USER scarh WITH PASSWORD 'scarh';
#   GRANT ALL PRIVILEGES ON DATABASE scarh TO scarh;
#   \c scarh
#   CREATE SCHEMA limnigrafos AUTHORIZATION scarh;
#
# (Django conecta con `search_path=limnigrafos`, ver `backend/core/settings.py`.)
DB_NAME=scarh
DB_USER=scarh
DB_PASSWORD=scarh
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=120
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# Backend de consola en lugar de SMTP real: los códigos de recuperación de contraseña se
# leen en la terminal donde corre `runserver`, no hace falta ninguna credencial de correo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=desarrollo@example.com
EMAIL_HOST_PASSWORD=sin-clave-en-local

# ---------------------------------------------------------------------------
# Superusuario y usuario de prueba (opcional)
# ---------------------------------------------------------------------------
# Sólo hacen falta si corrés `python manage.py createsuperuser_from_env` en vez del
# `createsuperuser` interactivo de Django.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=super-secure-password
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Local
ADMIN_IS_STAFF=True

USER_USERNAME=operador
USER_PASSWORD=super-secure-password
USER_EMAIL=operador@example.com
USER_FIRST_NAME=Operador
USER_LAST_NAME=Local
USER_IS_STAFF=True

# ---------------------------------------------------------------------------
# Simulador (simulator-go/)
# ---------------------------------------------------------------------------
# Opcional: `simulator-go/config.yaml` ya apunta a http://localhost:8000. Sólo hace falta
# si el backend corre en otro host o puerto.
# BACKEND_URL=http://localhost:8000
